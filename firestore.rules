rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == 'QrpHgMUCY6dy7Gl6VX0r4orauqo1';
    }

    match /speakingClubApplications/{applicationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'country',
          'spanishLevel',
          'timeZone',
          'candidateSlots',
          'scheduleAcknowledged',
          'scheduleTimeZone',
          'cohort',
          'goal',
          'consent',
          'status',
          'source',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() >= 2 &&
        request.resource.data.country.size() <= 60 &&
        request.resource.data.spanishLevel in ['B1', 'unsure'] &&
        request.resource.data.timeZone is string &&
        request.resource.data.timeZone.size() >= 2 &&
        request.resource.data.timeZone.size() <= 80 &&
        request.resource.data.candidateSlots is list &&
        request.resource.data.candidateSlots.size() >= 1 &&
        request.resource.data.candidateSlots.size() <= 17 &&
        request.resource.data.candidateSlots.hasOnly(['monday-1000', 'monday-1100', 'monday-1300', 'monday-1800', 'monday-1900', 'tuesday-1400', 'tuesday-1700', 'tuesday-1900', 'wednesday-0800', 'thursday-0800', 'thursday-1300', 'thursday-1400', 'friday-1100', 'friday-1400', 'friday-1500', 'saturday-1130', 'saturday-1330']) &&
        request.resource.data.scheduleAcknowledged == true &&
        request.resource.data.scheduleTimeZone == 'America/Bogota' &&
        request.resource.data.cohort == 'founding-2026-09' &&
        request.resource.data.goal is string &&
        request.resource.data.goal.size() >= 3 &&
        request.resource.data.goal.size() <= 500 &&
        request.resource.data.consent == true &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'speaking-club-page' &&
        request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'contactDate',
          'assignedGroup',
          'adminNotes',
          'paymentStatus',
          'expectedAmount',
          'paidAmount',
          'paymentDate',
          'paymentMethod',
          'paymentReference'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status in ['new', 'contacted', 'accepted', 'rejected']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactDate']) ||
          (request.resource.data.contactDate is string &&
            request.resource.data.contactDate.size() <= 10)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedGroup']) ||
          (request.resource.data.assignedGroup is string &&
            request.resource.data.assignedGroup.size() <= 80)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminNotes']) ||
          (request.resource.data.adminNotes is string &&
            request.resource.data.adminNotes.size() <= 2000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) ||
          request.resource.data.paymentStatus in ['pending', 'paid', 'refunded']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['expectedAmount']) ||
          (request.resource.data.expectedAmount is number &&
            request.resource.data.expectedAmount >= 0 &&
            request.resource.data.expectedAmount <= 10000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidAmount']) ||
          (request.resource.data.paidAmount is number &&
            request.resource.data.paidAmount >= 0 &&
            request.resource.data.paidAmount <= 10000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentDate']) ||
          (request.resource.data.paymentDate is string &&
            request.resource.data.paymentDate.size() <= 10)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethod']) ||
          request.resource.data.paymentMethod in ['', 'transfer', 'paypal', 'cash', 'other']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentReference']) ||
          (request.resource.data.paymentReference is string &&
            request.resource.data.paymentReference.size() <= 160));
      allow delete: if false;
    }

    match /speakingClubGroups/{groupId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name',
          'slot',
          'startDate',
          'sessionDates',
          'memberApplicationIds',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.slot in ['monday-1000', 'monday-1100', 'monday-1300', 'monday-1800', 'monday-1900', 'tuesday-1400', 'tuesday-1700', 'tuesday-1900', 'wednesday-0800', 'thursday-0800', 'thursday-1300', 'thursday-1400', 'friday-1100', 'friday-1400', 'friday-1500', 'saturday-1130', 'saturday-1330'] &&
        request.resource.data.startDate is string &&
        request.resource.data.startDate.size() == 10 &&
        request.resource.data.sessionDates is list &&
        request.resource.data.sessionDates.size() == 4 &&
        request.resource.data.memberApplicationIds is list &&
        request.resource.data.memberApplicationIds.size() >= 1 &&
        request.resource.data.memberApplicationIds.size() <= 5 &&
        request.resource.data.status == 'forming' &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meetingUrl', 'meetingUrlUpdatedAt']) &&
          request.resource.data.meetingUrl is string &&
          request.resource.data.meetingUrl.size() <= 120 &&
          request.resource.data.meetingUrl.matches('https://meet\\.google\\.com/[A-Za-z]{3}-[A-Za-z]{4}-[A-Za-z]{3}/?') &&
          request.resource.data.meetingUrlUpdatedAt == request.time) ||
        (resource.data.status == 'forming' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberApplicationIds']) &&
          request.resource.data.memberApplicationIds is list &&
          request.resource.data.memberApplicationIds.size() >= 1 &&
          request.resource.data.memberApplicationIds.size() <= 5) ||
        (resource.data.status == 'confirmed' &&
          resource.data.memberApplicationIds.size() >= 3 &&
          resource.data.memberApplicationIds.size() < 5 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberApplicationIds']) &&
          request.resource.data.memberApplicationIds is list &&
          request.resource.data.memberApplicationIds.size() == resource.data.memberApplicationIds.size() + 1 &&
          request.resource.data.memberApplicationIds.hasAll(resource.data.memberApplicationIds)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          ((resource.data.status == 'forming' &&
              resource.data.memberApplicationIds.size() >= 3 &&
              request.resource.data.status == 'confirmed') ||
            (resource.data.status == 'confirmed' &&
              resource.data.memberApplicationIds.size() < 3 &&
              request.resource.data.status == 'forming') ||
            (resource.data.status == 'confirmed' &&
              resource.data.memberApplicationIds.size() >= 3 &&
              request.resource.data.status == 'completed')))
      );
      allow delete: if false;
    }

    match /studentProfiles/{userId} {
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'paymentMethod',
          'paymentReference',
          'payerName',
          'amountSubmitted',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.paymentMethod in ['paypal', 'transfer', 'other'] &&
        request.resource.data.paymentReference is string &&
        request.resource.data.paymentReference.size() >= 4 &&
        request.resource.data.paymentReference.size() <= 160 &&
        request.resource.data.payerName is string &&
        request.resource.data.payerName.size() >= 2 &&
        request.resource.data.payerName.size() <= 100 &&
        request.resource.data.amountSubmitted is number &&
        request.resource.data.amountSubmitted > 0 &&
        request.resource.data.amountSubmitted <= 10000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin() ||
        (request.auth != null &&
          request.auth.uid == userId &&
          request.auth.token.email_verified == true);
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'applicationId',
          'groupName',
          'slot',
          'sessionDates',
          'meetingUrl',
          'activatedAt'
        ]) &&
        request.resource.data.status == 'active' &&
        request.resource.data.applicationId is string &&
        request.resource.data.groupName is string &&
        request.resource.data.groupName.size() >= 2 &&
        request.resource.data.groupName.size() <= 80 &&
        request.resource.data.slot in ['monday-1000', 'monday-1100', 'monday-1300', 'monday-1800', 'monday-1900', 'tuesday-1400', 'tuesday-1700', 'tuesday-1900', 'wednesday-0800', 'thursday-0800', 'thursday-1300', 'thursday-1400', 'friday-1100', 'friday-1400', 'friday-1500', 'saturday-1130', 'saturday-1330'] &&
        request.resource.data.sessionDates is list &&
        request.resource.data.sessionDates.size() == 4 &&
        request.resource.data.meetingUrl is string &&
        request.resource.data.meetingUrl.size() <= 120 &&
        request.resource.data.meetingUrl.matches('https://meet\\.google\\.com/[A-Za-z]{3}-[A-Za-z]{4}-[A-Za-z]{3}/?') &&
        request.resource.data.activatedAt == request.time;
      allow delete: if false;
    }

    match /privateAvailability/{slotId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == 'available';
      allow update: if isAdmin() || privateSlotChange(slotId) || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'heldBy', 'holdExpiresAt', 'bookingRequestId'
        ]) &&
        request.resource.data.heldBy == request.auth.uid &&
        (
          (
            (resource.data.status == 'available' ||
              (resource.data.status == 'held' && resource.data.holdExpiresAt <= request.time)) &&
            resource.data.googleCalendarBlocked == false &&
            resource.data.googleCalendarCheckedAt is timestamp &&
            resource.data.googleCalendarCheckedAt >= request.time - duration.value(35, 'm') &&
            resource.data.startAt is timestamp &&
            resource.data.startAt > request.time &&
            resource.data.startAt <= request.time + duration.value(21, 'd') &&
            request.resource.data.status == 'held' &&
            request.resource.data.holdExpiresAt > request.time &&
            request.resource.data.holdExpiresAt <= request.time + duration.value(10, 'm') &&
            request.resource.data.bookingRequestId == ''
          ) ||
          (
            resource.data.status == 'held' &&
            resource.data.heldBy == request.auth.uid &&
            resource.data.holdExpiresAt > request.time &&
            resource.data.googleCalendarBlocked == false &&
            resource.data.googleCalendarCheckedAt is timestamp &&
            resource.data.googleCalendarCheckedAt >= request.time - duration.value(35, 'm') &&
            resource.data.startAt is timestamp &&
            resource.data.startAt > request.time &&
            resource.data.startAt <= request.time + duration.value(21, 'd') &&
            request.resource.data.status == 'payment_review' &&
            request.resource.data.holdExpiresAt == resource.data.holdExpiresAt &&
            request.resource.data.bookingRequestId is string &&
            request.resource.data.bookingRequestId.size() >= 10 &&
            getAfter(/databases/$(database)/documents/privateBookingRequests/$(request.resource.data.bookingRequestId)).data.studentUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/privateBookingRequests/$(request.resource.data.bookingRequestId)).data.slotId == slotId
          )
        )
      );
    }

    match /privateBookingRequests/{requestId} {
      allow create: if privateCalendarProjection(requestId) || (request.auth != null &&
        request.resource.data.keys().hasOnly([
          'slotId', 'studentUid', 'fullName', 'email', 'studentTimeZone',
          'colombiaStart', 'packageId', 'packageLabel', 'amountUsd',
          'paymentMethod', 'paymentReference', 'payerName', 'status', 'createdAt'
        ]) &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.studentTimeZone is string &&
        request.resource.data.studentTimeZone.size() >= 2 &&
        request.resource.data.studentTimeZone.size() <= 80 &&
        request.resource.data.colombiaStart is timestamp &&
        request.resource.data.packageId in ['single', 'pack4', 'pack8'] &&
        request.resource.data.packageLabel is string &&
        request.resource.data.packageLabel.size() <= 60 &&
        request.resource.data.amountUsd in [25, 84, 152] &&
        request.resource.data.paymentMethod in ['paypal', 'transfer', 'other'] &&
        request.resource.data.paymentReference is string &&
        request.resource.data.paymentReference.size() >= 4 &&
        request.resource.data.paymentReference.size() <= 160 &&
        request.resource.data.payerName is string &&
        request.resource.data.payerName.size() >= 2 &&
        request.resource.data.payerName.size() <= 100 &&
        request.resource.data.status == 'payment_review' &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/privateAvailability/$(request.resource.data.slotId)).data.status == 'payment_review' &&
        getAfter(/databases/$(database)/documents/privateAvailability/$(request.resource.data.slotId)).data.heldBy == request.auth.uid);
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.studentUid);
      allow update: if isAdmin() || (resource.data.get('lessonId', '') == requestId && privateCalendarProjection(requestId));
      allow delete: if false;
    }

    // Spark: every balance change must commit with one immutable history entry.
    function ownsPrivateAccount(userId) {
      return request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true;
    }
    function accountAfter(uid) {
      return getAfter(/databases/$(database)/documents/privateAccounts/$(uid)).data;
    }
    function operationAfter(uid, id) {
      return getAfter(/databases/$(database)/documents/privateAccounts/$(uid)/history/$(id)).data;
    }
    function privateDuration(a) { return a.get('durationMinutes',a.get('terms',{}).get('durationMinutes',50)); }
    function validPrivateTerms(t) {
      return t == null || (t is map && t.keys().hasOnly(['durationMinutes','packageQuantity','packageAmountUsd','paymentUrl','paymentNote']) &&
        t.durationMinutes in [30,50] && t.packageQuantity is int && t.packageQuantity >= 1 && t.packageQuantity <= 100 &&
        t.packageAmountUsd is number && t.packageAmountUsd > 0 && t.packageAmountUsd <= 10000 &&
        t.paymentUrl is string && t.paymentUrl.size() <= 500 && (t.paymentUrl == '' || t.paymentUrl.matches('https://[^ ]+')) &&
        t.paymentNote is string && t.paymentNote.size() <= 500);
    }
    function accountShape(a) {
      return a.keys().hasOnly(['fullName','email','credited','used','reserved','createdAt','updatedAt','lastOperation','terms','durationMinutes']) && privateDuration(a) in [30,50] &&
        a.fullName is string && a.fullName.size() >= 2 && a.fullName.size() <= 80 &&
        a.email is string && a.email.size() >= 5 && a.email.size() <= 120 &&
        a.credited is int && a.used is int && a.reserved is int &&
        a.credited >= 0 && a.used >= 0 && a.reserved >= 0 && a.credited >= a.used + a.reserved &&
        a.lastOperation is string && a.lastOperation.size() >= 16 && a.lastOperation.size() <= 180 &&
        a.updatedAt == request.time;
    }
    function linkedAccountWrite(uid) {
      let a = request.resource.data;
      let h = operationAfter(uid, a.lastOperation);
      return accountShape(a) && (isAdmin() || ownsPrivateAccount(uid)) &&
        !exists(/databases/$(database)/documents/privateAccounts/$(uid)/history/$(a.lastOperation)) &&
        h.actorUid == request.auth.uid && h.createdAt == request.time &&
        h.credited == a.credited && h.used == a.used && h.reserved == a.reserved;
    }
    function validTarget(id, lessonId, start, minutes) {
      let before = get(/databases/$(database)/documents/privateAvailability/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/privateAvailability/$(id)).data;
      return before.status == 'available' && before.get('lessonId', '') == '' &&
        before.startAt == start && before.durationMinutes == 50 &&
        start > request.time && start <= request.time + duration.value(21, 'd') &&
        before.googleCalendarBlocked == false &&
        before.googleCalendarCheckedAt >= request.time - duration.value(35, 'm') &&
        after.status == 'confirmed' && after.lessonId == lessonId && after.durationMinutes == minutes &&
        after.heldBy == '' && after.bookingRequestId == lessonId && after.holdExpiresAt == request.time &&
        after.diff(before).affectedKeys().hasOnly(['status','durationMinutes','lessonId','heldBy','bookingRequestId','holdExpiresAt']);
    }
    function releasedSlot(id, lessonId) {
      let before = get(/databases/$(database)/documents/privateAvailability/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/privateAvailability/$(id)).data;
      return before.status == 'confirmed' && before.lessonId == lessonId &&
        after.status == 'available' && after.durationMinutes == 50 && after.lessonId == '' && after.heldBy == '' &&
        after.bookingRequestId == '' && after.holdExpiresAt == request.time &&
        after.googleCalendarCheckedAt == timestamp.value(0) &&
        after.diff(before).affectedKeys().hasOnly(['status','durationMinutes','lessonId','heldBy','bookingRequestId','holdExpiresAt','googleCalendarCheckedAt']);
    }
    function lessonShape(l, uid, opId) {
      return l.keys().hasOnly(['studentUid','fullName','email','slotId','startAt','durationMinutes','status','createdAt','updatedAt','operationId']) &&
        l.studentUid == uid && l.operationId == opId && l.updatedAt == request.time &&
        l.durationMinutes in [30,50] && l.slotId is string && l.startAt is timestamp;
    }
    function calendarMatches(l, id) {
      let p = getAfter(/databases/$(database)/documents/privateBookingRequests/$(id)).data;
      return p.keys().hasOnly(['studentUid','fullName','email','slotId','colombiaStart','status','packageLabel','lessonId']) &&
        p.lessonId == id && p.studentUid == l.studentUid && p.fullName == l.fullName && p.email == l.email &&
        p.slotId == l.slotId && p.colombiaStart == l.startAt && p.packageLabel == 'Prepaid class balance' &&
        p.status == (l.status in ['reserved','completed','no_show'] ? 'confirmed' : 'cancelled');
    }
    function privateCalendarProjection(id) {
      let l = getAfter(/databases/$(database)/documents/privateLessons/$(id)).data;
      let h = operationAfter(l.studentUid, l.operationId);
      return (isAdmin() || ownsPrivateAccount(l.studentUid)) && calendarMatches(l,id) &&
        h.actorUid == request.auth.uid && h.createdAt == request.time && h.lessonId == id &&
        accountAfter(l.studentUid).lastOperation == l.operationId &&
        !exists(/databases/$(database)/documents/privateAccounts/$(l.studentUid)/history/$(l.operationId));
    }
    function validBooking(uid, opId, h, a) {
      let l = getAfter(/databases/$(database)/documents/privateLessons/$(h.lessonId)).data;
      return !exists(/databases/$(database)/documents/privateLessons/$(h.lessonId)) &&
        lessonShape(l, uid, opId) && l.fullName == a.fullName && l.email == a.email &&
        l.durationMinutes == privateDuration(a) && l.createdAt == request.time && l.status == 'reserved' && calendarMatches(l,h.lessonId) &&
        h.fromSlotId == '' && h.fromStartAt == null && h.toSlotId == l.slotId && h.toStartAt == l.startAt &&
        validTarget(l.slotId, h.lessonId, l.startAt, l.durationMinutes);
    }
    function validLessonChange(uid, opId, h) {
      let before = get(/databases/$(database)/documents/privateLessons/$(h.lessonId)).data;
      let after = getAfter(/databases/$(database)/documents/privateLessons/$(h.lessonId)).data;
      return before.studentUid == uid && before.status == 'reserved' && lessonShape(after, uid, opId) && calendarMatches(after,h.lessonId) &&
        after.durationMinutes == before.durationMinutes && after.fullName == before.fullName && after.email == before.email && after.createdAt == before.createdAt &&
        h.fromSlotId == before.slotId && h.fromStartAt == before.startAt &&
        (isAdmin() || before.startAt >= request.time + duration.value(24, 'h')) &&
        ((h.action == 'reschedule' && after.status == 'reserved' && before.slotId != after.slotId &&
            h.toSlotId == after.slotId && h.toStartAt == after.startAt &&
            validTarget(after.slotId, h.lessonId, after.startAt, after.durationMinutes) && releasedSlot(before.slotId, h.lessonId)) ||
          (h.action in ['cancel','late_cancel','complete','no_show'] &&
            after.slotId == before.slotId && after.startAt == before.startAt && h.toSlotId == '' && h.toStartAt == null &&
            ((h.action == 'cancel' && after.status == 'cancelled' && releasedSlot(before.slotId, h.lessonId)) ||
             (h.action == 'late_cancel' && isAdmin() && before.startAt < request.time + duration.value(24, 'h') &&
                after.status == 'late_cancelled' && releasedSlot(before.slotId, h.lessonId)) ||
             (h.action in ['complete','no_show'] && isAdmin() && before.startAt + duration.value(before.durationMinutes, 'm') <= request.time &&
                after.status == (h.action == 'complete' ? 'completed' : 'no_show')))));
    }
    function balanceChange(uid, h, a) {
      let b = get(/databases/$(database)/documents/privateAccounts/$(uid)).data;
      return a.fullName == b.fullName && a.email == b.email && a.createdAt == b.createdAt &&
        (h.action in ['configure','correct_duration'] || (a.get('terms',null) == b.get('terms',null) && privateDuration(a) == privateDuration(b))) &&
        ((h.action == 'correct_duration' && isAdmin() && h.quantity == 0 && b.reserved == 0 && a.reserved == 0 && a.credited == b.credited && a.used == b.used &&
            h.durationMinutes == privateDuration(a) && h.previousDurationMinutes == privateDuration(b) &&
            (a.get('terms',{}) == b.get('terms',{}) || (a.get('terms',{}).diff(b.get('terms',{})).affectedKeys().hasOnly(['durationMinutes']) && a.terms.durationMinutes == privateDuration(a)))) ||
         (h.action == 'configure' && isAdmin() && h.quantity == 0 && a.credited == b.credited && a.used == b.used && a.reserved == b.reserved &&
            (privateDuration(a) == privateDuration(b) || b.credited == b.used)) ||
         (h.action == 'credit' && isAdmin() && h.quantity != 0 &&
            a.credited == b.credited + h.quantity && a.used == b.used && a.reserved == b.reserved) ||
         (h.quantity == 0 && a.credited == b.credited &&
            ((h.action == 'book' && a.reserved == b.reserved + 1 && a.used == b.used) ||
             (h.action == 'reschedule' && a.reserved == b.reserved && a.used == b.used) ||
             (h.action == 'cancel' && a.reserved == b.reserved - 1 && a.used == b.used) ||
             (h.action in ['complete','no_show','late_cancel'] && isAdmin() && a.reserved == b.reserved - 1 && a.used == b.used + 1))));
    }
    function validHistory(uid, opId) {
      let h = request.resource.data;
      let a = accountAfter(uid);
      return (isAdmin() || ownsPrivateAccount(uid)) &&
        h.keys().hasOnly(['action','quantity','reason','actorUid','actorRole','createdAt','lessonId','fromSlotId','toSlotId','fromStartAt','toStartAt','credited','used','reserved','fingerprint','paymentReportId','terms','durationMinutes','previousDurationMinutes']) &&
        h.actorUid == request.auth.uid && h.actorRole == (isAdmin() ? 'admin' : 'student') && h.createdAt == request.time &&
        h.reason is string && h.reason.size() <= 500 && (!isAdmin() || h.reason.size() >= 3) &&
        h.fingerprint is string && h.fingerprint.size() <= 3000 &&
        h.quantity is int && h.quantity >= -10000 && h.quantity <= 10000 &&
        h.lessonId is string && h.lessonId.size() <= 180 && h.fromSlotId is string && h.toSlotId is string &&
        a.updatedAt == request.time && a.lastOperation == opId && h.credited == a.credited && h.used == a.used && h.reserved == a.reserved &&
        (h.get('paymentReportId','') == '' || validTopupCredit(uid,opId,h)) &&
        (!(h.action in ['open','configure']) || (validPrivateTerms(a.get('terms',null)) && h.get('terms',null) == a.get('terms',null))) &&
        ((h.action == 'open' && isAdmin() && !exists(/databases/$(database)/documents/privateAccounts/$(uid)) &&
            a.createdAt == request.time && h.quantity >= 0 && a.credited == h.quantity && a.used == 0 && a.reserved == 0) ||
         (h.action != 'open' && balanceChange(uid, h, a))) &&
        ((h.action in ['open','configure','correct_duration','credit'] && h.lessonId == '' && h.fromSlotId == '' && h.toSlotId == '' && h.fromStartAt == null && h.toStartAt == null) ||
         (h.action == 'book' && validBooking(uid, opId, h, a)) ||
         (h.action in ['cancel','reschedule','complete','no_show','late_cancel'] && validLessonChange(uid, opId, h)));
    }
    function linkedLessonWrite(lessonId) {
      let l = request.resource.data;
      let h = operationAfter(l.studentUid, l.operationId);
      return (isAdmin() || ownsPrivateAccount(l.studentUid)) &&
        h.createdAt == request.time && h.actorUid == request.auth.uid && h.lessonId == lessonId &&
        accountAfter(l.studentUid).lastOperation == l.operationId &&
        !exists(/databases/$(database)/documents/privateAccounts/$(l.studentUid)/history/$(l.operationId));
    }
    function privateSlotChange(slotId) {
      let id = request.resource.data.get('lessonId', '') != '' ? request.resource.data.lessonId : resource.data.get('lessonId', '');
      let l = getAfter(/databases/$(database)/documents/privateLessons/$(id)).data;
      let h = operationAfter(l.studentUid, l.operationId);
      return ownsPrivateAccount(l.studentUid) && h.actorUid == request.auth.uid && h.createdAt == request.time &&
        h.lessonId == id && h.action in ['book','cancel','reschedule'] &&
        accountAfter(l.studentUid).lastOperation == l.operationId &&
        (h.fromSlotId == slotId || h.toSlotId == slotId) &&
        !exists(/databases/$(database)/documents/privateAccounts/$(l.studentUid)/history/$(l.operationId));
    }
    match /privateClassLinks/{userId} {
      allow read: if isAdmin() || ownsPrivateAccount(userId);
      allow create, update: if isAdmin() && existsAfter(/databases/$(database)/documents/privateAccounts/$(userId)) &&
        request.resource.data.keys().hasOnly(['url','updatedBy','updatedAt']) &&
        request.resource.data.url is string && request.resource.data.url.size() <= 1000 &&
        (request.resource.data.url == '' || request.resource.data.url.matches('https://[^ ]+')) &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /privateAccounts/{userId} {
      allow read: if isAdmin() || ownsPrivateAccount(userId);
      allow create, update: if linkedAccountWrite(userId);
      allow delete: if false;
      match /history/{entryId} {
        allow read: if isAdmin() || ownsPrivateAccount(userId);
        allow create: if validHistory(userId, entryId);
        allow update, delete: if false;
      }
    }
    match /privateLessons/{lessonId} {
      allow read: if isAdmin() || ownsPrivateAccount(resource.data.studentUid);
      allow create, update: if linkedLessonWrite(lessonId);
      allow delete: if false;
    }
    function topupAfter(id) {
      return getAfter(/databases/$(database)/documents/privateTopups/$(id)).data;
    }
    function topupJob(id, kind, uid) {
      let j = getAfter(/databases/$(database)/documents/privateTopupMail/$(id + '_' + kind)).data;
      return j.reportId == id && j.kind == kind && j.studentUid == uid && j.status == (topupAfter(id).packageId == 'custom' ? 'terms_pending' : 'pending') && j.createdAt == request.time;
    }
    function topupPackage(r) {
      let a = get(/databases/$(database)/documents/privateAccounts/$(r.studentUid)).data;
      let t = a.get('terms',null);
      return t != null ? (r.packageId == 'custom' && r.quantity == t.packageQuantity && r.amountUsd == t.packageAmountUsd &&
        r.durationMinutes == privateDuration(a) && r.packageLabel is string && r.packageLabel.size() <= 80) : (r.get('durationMinutes',50) == privateDuration(a) && ((r.packageId == 'single' && r.packageLabel == '1 private class' && r.quantity == 1 && r.amountUsd == 25) ||
        (r.packageId == 'pack4' && r.packageLabel == '4 private classes' && r.quantity == 4 && r.amountUsd == 84) ||
        (r.packageId == 'pack8' && r.packageLabel == '8 private classes' && r.quantity == 8 && r.amountUsd == 152)));
    }
    function validTopupCredit(uid, opId, h) {
      let r = topupAfter(h.paymentReportId);
      let before = get(/databases/$(database)/documents/privateTopups/$(h.paymentReportId)).data;
      return isAdmin() && h.action == 'credit' && before.status == 'pending' && r.status == 'confirmed' &&
        r.get('durationMinutes',50) == privateDuration(accountAfter(uid)) && r.studentUid == uid && r.quantity == h.quantity && r.reviewOperationId == opId && r.reviewedAt == request.time;
    }
    function topupConfirmed(id, r) {
      let a = accountAfter(r.studentUid);
      let h = operationAfter(r.studentUid,r.reviewOperationId);
      let claim = getAfter(/databases/$(database)/documents/privateTopupClaims/$(r.referenceKey)).data;
      return a.lastOperation == r.reviewOperationId && a.updatedAt == request.time &&
        h.action == 'credit' && h.paymentReportId == id && h.quantity == r.quantity && h.createdAt == request.time &&
        !exists(/databases/$(database)/documents/privateAccounts/$(r.studentUid)/history/$(r.reviewOperationId)) &&
        !exists(/databases/$(database)/documents/privateTopupClaims/$(r.referenceKey)) && claim.reportId == id &&
        topupJob(id,'student_confirmed',r.studentUid);
    }
    match /privateTopups/{reportId} {
      allow read: if isAdmin() || ownsPrivateAccount(resource.data.studentUid);
      // Also allow the owner to read a missing deterministic ID before reporting.
      allow get: if request.auth != null && request.auth.token.email_verified == true &&
        reportId.matches('^' + request.auth.uid + '_(wise|paypal|transfer|other)_[A-Z0-9_-]{4,100}$');
      allow create: if ownsPrivateAccount(request.resource.data.studentUid) &&
        request.resource.data.keys().hasOnly(['studentUid','fullName','email','packageId','packageLabel','quantity','amountUsd','paymentMethod','paymentReference','referenceKey','payerName','status','createdAt','durationMinutes']) &&
        reportId == request.auth.uid + '_' + request.resource.data.referenceKey && reportId.size() <= 180 &&
        request.resource.data.fullName == get(/databases/$(database)/documents/privateAccounts/$(request.auth.uid)).data.fullName &&
        request.resource.data.email == get(/databases/$(database)/documents/privateAccounts/$(request.auth.uid)).data.email &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.paymentMethod in ['wise','paypal','transfer','other'] &&
        request.resource.data.paymentReference.matches('^[A-Z0-9_-]{4,100}$') &&
        request.resource.data.referenceKey == request.resource.data.paymentMethod + '_' + request.resource.data.paymentReference &&
        request.resource.data.payerName is string && request.resource.data.payerName.size() >= 2 && request.resource.data.payerName.size() <= 100 &&
        topupPackage(request.resource.data) && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        topupJob(reportId,'admin_received',request.auth.uid) && topupJob(reportId,'student_received',request.auth.uid);
      allow update: if isAdmin() && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','reviewNote','reviewOperationId']) &&
        request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time &&
        request.resource.data.reviewOperationId is string && request.resource.data.reviewOperationId.size() >= 16 &&
        request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() >= 3 && request.resource.data.reviewNote.size() <= 500 &&
        ((request.resource.data.status == 'confirmed' && topupConfirmed(reportId,request.resource.data)) ||
         (request.resource.data.status == 'rejected' && topupJob(reportId,'student_rejected',resource.data.studentUid)));
      allow delete: if false;
    }
    match /privateTopupClaims/{referenceKey} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['reportId','studentUid','createdAt']) &&
        request.resource.data.createdAt == request.time &&
        topupAfter(request.resource.data.reportId).referenceKey == referenceKey &&
        topupAfter(request.resource.data.reportId).studentUid == request.resource.data.studentUid &&
        topupAfter(request.resource.data.reportId).status == 'confirmed' &&
        topupAfter(request.resource.data.reportId).reviewedAt == request.time;
      allow update, delete: if false;
    }
    function validLessonMail(id,j) {
      let h=operationAfter(j.studentUid,j.reportId);
      return (isAdmin() || ownsPrivateAccount(j.studentUid)) &&
        j.keys().hasOnly(['reportId','studentUid','kind','status','createdAt']) &&
        j.status == 'lesson_pending' && j.createdAt == request.time && id == j.reportId + '_' + j.kind &&
        j.kind in ['admin_booking','student_booking','admin_reschedule','student_reschedule'] &&
        h.action == (j.kind in ['admin_booking','student_booking'] ? 'book' : 'reschedule') &&
        h.actorUid == request.auth.uid && h.createdAt == request.time && accountAfter(j.studentUid).lastOperation == j.reportId &&
        !exists(/databases/$(database)/documents/privateAccounts/$(j.studentUid)/history/$(j.reportId));
    }
    match /privateTopupMail/{jobId} {
      allow create: if validLessonMail(jobId,request.resource.data);
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['reportId','studentUid','kind','status','createdAt']) &&
        request.resource.data.status == (topupAfter(request.resource.data.reportId).packageId == 'custom' ? 'terms_pending' : 'pending') && request.resource.data.createdAt == request.time &&
        jobId == request.resource.data.reportId + '_' + request.resource.data.kind &&
        topupAfter(request.resource.data.reportId).studentUid == request.resource.data.studentUid &&
        (((isAdmin() || ownsPrivateAccount(request.resource.data.studentUid)) &&
          request.resource.data.kind in ['admin_received','student_received'] &&
          topupAfter(request.resource.data.reportId).status == 'pending' && topupAfter(request.resource.data.reportId).createdAt == request.time) ||
         (isAdmin() && topupAfter(request.resource.data.reportId).reviewedAt == request.time &&
          ((request.resource.data.kind == 'student_confirmed' && topupAfter(request.resource.data.reportId).status == 'confirmed') ||
           (request.resource.data.kind == 'student_rejected' && topupAfter(request.resource.data.reportId).status == 'rejected'))));
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['reportId','studentUid','kind','status','createdAt']) &&
        request.resource.data.reportId == request.auth.uid && request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.kind == 'admin_activation' && jobId == request.auth.uid + '_admin_activation' &&
        request.resource.data.status == 'activation_pending' && request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/privateEnrollments/$(request.auth.uid)).data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/privateEnrollments/$(request.auth.uid)).data.email == request.auth.token.email;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['reportId','studentUid','kind','status','createdAt']) &&
        request.resource.data.reportId == request.resource.data.studentUid &&
        request.resource.data.kind == 'student_activated' && jobId == request.resource.data.studentUid + '_student_activated' &&
        request.resource.data.status == 'activation_pending' && request.resource.data.createdAt == request.time &&
        !exists(/databases/$(database)/documents/privateAccounts/$(request.resource.data.studentUid)) &&
        getAfter(/databases/$(database)/documents/privateAccounts/$(request.resource.data.studentUid)).data.createdAt == request.time;
      // Only the Apps Script service (IAM) may mark messages sent or retry them.
      allow update, delete: if false;
    }
    match /privateTopupSettings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /privateEnrollments/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['fullName', 'email', 'createdAt']) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email == request.auth.token.email && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || ownsPrivateAccount(userId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
