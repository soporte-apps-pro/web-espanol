rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == 'QrpHgMUCY6dy7Gl6VX0r4orauqo1';
    }

    match /speakingClubApplications/{applicationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'country',
          'spanishLevel',
          'timeZone',
          'candidateSlots',
          'scheduleAcknowledged',
          'scheduleTimeZone',
          'cohort',
          'goal',
          'consent',
          'status',
          'source',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() >= 2 &&
        request.resource.data.country.size() <= 60 &&
        request.resource.data.spanishLevel in ['B1', 'unsure'] &&
        request.resource.data.timeZone is string &&
        request.resource.data.timeZone.size() >= 2 &&
        request.resource.data.timeZone.size() <= 80 &&
        request.resource.data.candidateSlots is list &&
        request.resource.data.candidateSlots.size() >= 1 &&
        request.resource.data.candidateSlots.size() <= 5 &&
        request.resource.data.candidateSlots.hasOnly(['monday-1000', 'tuesday-1700', 'wednesday-0800', 'thursday-1400', 'friday-1100']) &&
        request.resource.data.scheduleAcknowledged == true &&
        request.resource.data.scheduleTimeZone == 'America/Bogota' &&
        request.resource.data.cohort == 'founding-2026-09' &&
        request.resource.data.goal is string &&
        request.resource.data.goal.size() >= 3 &&
        request.resource.data.goal.size() <= 500 &&
        request.resource.data.consent == true &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'speaking-club-page' &&
        request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'contactDate',
          'assignedGroup',
          'adminNotes',
          'paymentStatus',
          'expectedAmount',
          'paidAmount',
          'paymentDate',
          'paymentMethod',
          'paymentReference'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status in ['new', 'contacted', 'accepted', 'rejected']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactDate']) ||
          (request.resource.data.contactDate is string &&
            request.resource.data.contactDate.size() <= 10)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedGroup']) ||
          (request.resource.data.assignedGroup is string &&
            request.resource.data.assignedGroup.size() <= 80)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminNotes']) ||
          (request.resource.data.adminNotes is string &&
            request.resource.data.adminNotes.size() <= 2000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) ||
          request.resource.data.paymentStatus in ['pending', 'paid', 'refunded']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['expectedAmount']) ||
          (request.resource.data.expectedAmount is number &&
            request.resource.data.expectedAmount >= 0 &&
            request.resource.data.expectedAmount <= 10000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidAmount']) ||
          (request.resource.data.paidAmount is number &&
            request.resource.data.paidAmount >= 0 &&
            request.resource.data.paidAmount <= 10000)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentDate']) ||
          (request.resource.data.paymentDate is string &&
            request.resource.data.paymentDate.size() <= 10)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethod']) ||
          request.resource.data.paymentMethod in ['', 'transfer', 'paypal', 'cash', 'other']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentReference']) ||
          (request.resource.data.paymentReference is string &&
            request.resource.data.paymentReference.size() <= 160));
      allow delete: if false;
    }

    match /speakingClubGroups/{groupId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name',
          'slot',
          'startDate',
          'sessionDates',
          'memberApplicationIds',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.slot in ['monday-1000', 'tuesday-1700', 'wednesday-0800', 'thursday-1400', 'friday-1100'] &&
        request.resource.data.startDate is string &&
        request.resource.data.startDate.size() == 10 &&
        request.resource.data.sessionDates is list &&
        request.resource.data.sessionDates.size() == 6 &&
        request.resource.data.memberApplicationIds is list &&
        request.resource.data.memberApplicationIds.size() >= 1 &&
        request.resource.data.memberApplicationIds.size() <= 5 &&
        request.resource.data.status == 'forming' &&
        request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meetingUrl', 'meetingUrlUpdatedAt']) &&
          request.resource.data.meetingUrl is string &&
          request.resource.data.meetingUrl.size() <= 120 &&
          request.resource.data.meetingUrl.matches('https://meet\\.google\\.com/[A-Za-z]{3}-[A-Za-z]{4}-[A-Za-z]{3}/?') &&
          request.resource.data.meetingUrlUpdatedAt == request.time) ||
        (resource.data.status == 'forming' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberApplicationIds']) &&
          request.resource.data.memberApplicationIds is list &&
          request.resource.data.memberApplicationIds.size() >= 1 &&
          request.resource.data.memberApplicationIds.size() <= 5) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          ((resource.data.status == 'forming' &&
              resource.data.memberApplicationIds.size() >= 4 &&
              request.resource.data.status == 'confirmed') ||
            (resource.data.status == 'confirmed' &&
              resource.data.memberApplicationIds.size() < 4 &&
              request.resource.data.status == 'forming') ||
            (resource.data.status == 'confirmed' &&
              resource.data.memberApplicationIds.size() >= 4 &&
              request.resource.data.status == 'completed')))
      );
      allow delete: if false;
    }

    match /studentProfiles/{userId} {
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'paymentMethod',
          'paymentReference',
          'payerName',
          'amountSubmitted',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.paymentMethod in ['paypal', 'transfer', 'other'] &&
        request.resource.data.paymentReference is string &&
        request.resource.data.paymentReference.size() >= 4 &&
        request.resource.data.paymentReference.size() <= 160 &&
        request.resource.data.payerName is string &&
        request.resource.data.payerName.size() >= 2 &&
        request.resource.data.payerName.size() <= 100 &&
        request.resource.data.amountSubmitted is number &&
        request.resource.data.amountSubmitted > 0 &&
        request.resource.data.amountSubmitted <= 10000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin() ||
        (request.auth != null &&
          request.auth.uid == userId &&
          request.auth.token.email_verified == true);
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'applicationId',
          'groupName',
          'slot',
          'sessionDates',
          'meetingUrl',
          'activatedAt'
        ]) &&
        request.resource.data.status == 'active' &&
        request.resource.data.applicationId is string &&
        request.resource.data.groupName is string &&
        request.resource.data.groupName.size() >= 2 &&
        request.resource.data.groupName.size() <= 80 &&
        request.resource.data.slot in ['monday-1000', 'tuesday-1700', 'wednesday-0800', 'thursday-1400', 'friday-1100'] &&
        request.resource.data.sessionDates is list &&
        request.resource.data.sessionDates.size() == 6 &&
        request.resource.data.meetingUrl is string &&
        request.resource.data.meetingUrl.size() <= 120 &&
        request.resource.data.meetingUrl.matches('https://meet\\.google\\.com/[A-Za-z]{3}-[A-Za-z]{4}-[A-Za-z]{3}/?') &&
        request.resource.data.activatedAt == request.time;
      allow delete: if false;
    }

    match /privateAvailability/{slotId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == 'available';
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'heldBy', 'holdExpiresAt', 'bookingRequestId'
        ]) &&
        request.resource.data.heldBy == request.auth.uid &&
        (
          (
            (resource.data.status == 'available' ||
              (resource.data.status == 'held' && resource.data.holdExpiresAt <= request.time)) &&
            resource.data.googleCalendarBlocked == false &&
            resource.data.googleCalendarCheckedAt is timestamp &&
            resource.data.googleCalendarCheckedAt >= request.time - duration.value(35, 'm') &&
            resource.data.startAt is timestamp &&
            resource.data.startAt > request.time &&
            resource.data.startAt <= request.time + duration.value(21, 'd') &&
            request.resource.data.status == 'held' &&
            request.resource.data.holdExpiresAt > request.time &&
            request.resource.data.holdExpiresAt <= request.time + duration.value(10, 'm') &&
            request.resource.data.bookingRequestId == ''
          ) ||
          (
            resource.data.status == 'held' &&
            resource.data.heldBy == request.auth.uid &&
            resource.data.holdExpiresAt > request.time &&
            resource.data.googleCalendarBlocked == false &&
            resource.data.googleCalendarCheckedAt is timestamp &&
            resource.data.googleCalendarCheckedAt >= request.time - duration.value(35, 'm') &&
            resource.data.startAt is timestamp &&
            resource.data.startAt > request.time &&
            resource.data.startAt <= request.time + duration.value(21, 'd') &&
            request.resource.data.status == 'payment_review' &&
            request.resource.data.holdExpiresAt == resource.data.holdExpiresAt &&
            request.resource.data.bookingRequestId is string &&
            request.resource.data.bookingRequestId.size() >= 10 &&
            getAfter(/databases/$(database)/documents/privateBookingRequests/$(request.resource.data.bookingRequestId)).data.studentUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/privateBookingRequests/$(request.resource.data.bookingRequestId)).data.slotId == slotId
          )
        )
      );
    }

    match /privateBookingRequests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'slotId', 'studentUid', 'fullName', 'email', 'studentTimeZone',
          'colombiaStart', 'packageId', 'packageLabel', 'amountUsd',
          'paymentMethod', 'paymentReference', 'payerName', 'status', 'createdAt'
        ]) &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.studentTimeZone is string &&
        request.resource.data.studentTimeZone.size() >= 2 &&
        request.resource.data.studentTimeZone.size() <= 80 &&
        request.resource.data.colombiaStart is timestamp &&
        request.resource.data.packageId in ['single', 'pack4', 'pack8'] &&
        request.resource.data.packageLabel is string &&
        request.resource.data.packageLabel.size() <= 60 &&
        request.resource.data.amountUsd in [25, 84, 152] &&
        request.resource.data.paymentMethod in ['paypal', 'transfer', 'other'] &&
        request.resource.data.paymentReference is string &&
        request.resource.data.paymentReference.size() >= 4 &&
        request.resource.data.paymentReference.size() <= 160 &&
        request.resource.data.payerName is string &&
        request.resource.data.payerName.size() >= 2 &&
        request.resource.data.payerName.size() <= 100 &&
        request.resource.data.status == 'payment_review' &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/privateAvailability/$(request.resource.data.slotId)).data.status == 'payment_review' &&
        getAfter(/databases/$(database)/documents/privateAvailability/$(request.resource.data.slotId)).data.heldBy == request.auth.uid;
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.studentUid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
